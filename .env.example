# Chave do Google AI Studio (https://aistudio.google.com/apikey).
# Copie este arquivo para .env e preencha o valor. O .env não vai para o Git.
GOOGLE_API_KEY=

# Usa a API do Google AI Studio (e não a Vertex AI). Deixe como está.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelos Gemini de cada camada de agentes (opcionais; valores abaixo são o padrão).
AURORA_MODELO_PRINCIPAL=gemini-3.5-flash-lite
AURORA_MODELO_ESPECIALISTA=gemini-3.5-flash-lite

# Pasta onde ficam o banco do condomínio e o banco de sessões (opcional).
# AURORA_DIR_ESTADO=estado
